{
  "name": "layarbelajar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts playwright.auth.config.ts eslint.config.js index.html package.json tsconfig.json tsconfig.app.json tsconfig.node.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts playwright.auth.config.ts eslint.config.js index.html package.json tsconfig.json tsconfig.app.json tsconfig.node.json .github/workflows/*.yml",
    "test:unit": "vitest run src",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:tokens": "node scripts/check-token-contrast.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "supabase:start": "supabase start",
    "supabase:reset:local": "supabase db reset --local",
    "test:e2e:auth:local": "node scripts/test-local-auth-browser.mjs",
    "test:staging-preflight": "node --test scripts/staging-preflight.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
